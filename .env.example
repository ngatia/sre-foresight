# Copy this file to .env and edit as needed (or set these as real env vars /
# container env / Helm values - see README.md > Configuration reference).

# Prometheus-compatible metrics source (self-hosted Prometheus, Mimir, Thanos,
# Amazon Managed Prometheus, Grafana Cloud). Required.
PROMETHEUS_URL=http://localhost:9090

# Bearer token for the Prometheus endpoint, if it requires auth (e.g. Grafana
# Cloud, Amazon Managed Prometheus). Leave unset for an unauthenticated source.
# PROMETHEUS_TOKEN=

# SQLAlchemy async URL for state storage. Defaults to a local SQLite file
# (sqlite+aiosqlite:///./data/foresight.db) if unset. Set this to point at
# Postgres instead:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/foresight

# Path to your SLO definitions (see config/slos.example.yaml for the format).
# This file is NOT shipped - copy the example to config/slos.yaml first.
SLO_CONFIG_PATH=config/slos.yaml

# How often (in seconds) each SLO is re-evaluated: query the SLI, compute burn
# rate and budget, persist a sample, forecast exhaustion, and correlate/notify
# on threshold.
POLL_INTERVAL_SECONDS=60

# Slack incoming webhook URL. When set, every alert also posts a formatted
# Slack message (burn rate, budget remaining, forecast, probable cause).
# SLACK_WEBHOOK_URL=

# Generic outgoing webhook URL. When set, every alert POSTs the notification
# as JSON to this endpoint (for anything that isn't Slack).
# NOTIFY_WEBHOOK_URL=

# Directory to write a Markdown postmortem draft into when a critical alert
# fires. Leave unset to skip postmortem generation.
# POSTMORTEM_DIR=/app/postmortems

# Enable the optional in-cluster Kubernetes Deployment watcher, which maps
# rollouts to deploy change-events automatically. Requires in-cluster RBAC to
# watch Deployments. Off by default - the generic /api/events webhook always
# works without this.
# KUBERNETES_WATCH_ENABLED=false

# Optional ArgoCD adapter: polls synced Applications and records them as
# deploy change-events for correlation. Requires both ARGOCD_URL and
# ARGOCD_TOKEN to be set.
# ARGOCD_URL=
# ARGOCD_TOKEN=

# Skip TLS verification when polling ArgoCD. Only for a self-signed homelab
# instance; never enable against a real endpoint. Off by default.
# ARGOCD_INSECURE=false
